/*
 * Anbernic RG Rotate (Unisoc UMS512 / T618, sharkl5pro) board DTS.
 *
 * 7.1 rebase of the 6.16 ums512 bring-up (see docs/REBASE-7.1-SURVEY.md).
 * The RG Rotate is a ums512_1h10 variant; this board file layers the
 * device-specific deltas on top of upstream's generic ums512.dtsi.
 *
 * NOTE ON SCOPE (7.1 rebase, stage 1):
 * Upstream's ums512.dtsi is far leaner than our 6.16 tree's. It currently
 * provides only: uart0/1, sdio0/sdio3, gpu clk syscon, ap_clk/apapb_gate,
 * ap_ahb_regs. It does NOT yet carry SoC nodes for: ap_gpio, pinctrl, pwm,
 * dpu/dsi/disp/iommu_disp (display), hsphy/usb, i2c2/i2c4, the audio
 * codec/VBC/pcm graph, or the cpufreq-dvfs supplies. So this board file
 * wires only what upstream's dtsi can back today (serial, SD, eMMC, the
 * SC2730 fuel gauge). The remaining subsystems are staged below as an
 * inline roadmap and land as their SoC nodes are ported into the 7.1 dtsi,
 * one independently-bootable subsystem at a time. Cross-ref the memories /
 * docs cited per block.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "ums512.dtsi"
#include "sc2730.dtsi"

/ {
	model = "Anbernic RG Rotate";
	compatible = "sprd,ums512-1h10", "sprd,ums512";
	sprd,sc-id = "ums512 1h10 1000";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		stdout-path = "serial1:115200n8";

		framebuffer0: framebuffer@9e000000 {
			compatible = "simple-framebuffer";
			memory-region = <&framebuffer_region>;
			width = <720>;
			height = <720>;
			stride = <(720 * 4)>;
			format = "a8r8g8b8";
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer_region: framebuffer-region@9e000000 {
			compatible = "framebuffer";
			reg = <0 0x9e000000 0 (720 * 720 * 4)>;
			iommu-addresses = <&dpu 0x9e000000 (720 * 720 * 4)>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x0 0x8000000>;
			reusable;
			linux,cma-default;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 2 40000>;
		max-brightness = <4095>;
		default-brightness-level = <2650>;
	};

	lcd_avdd: regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avdd";
		gpio = <&ap_gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	lcd_avee: regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avee";
		gpio = <&ap_gpio 138 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/*
	 * Battery profile for the RG Rotate cell. Values transcribed from the
	 * stock dtbo overlay (device/stock/dtbo_decompiled/dtbo_overlay_1.dts,
	 * the authoritative source for this SKU). Consumed by the SC2730 fuel
	 * gauge (sc2730_fgu) via monitored-battery.
	 */
	bat: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <1900000>;
		charge-term-current-microamp = <120000>;
		constant-charge-voltage-max-microvolt = <4340000>;
		factory-internal-resistance-micro-ohms = <230000>;
		voltage-min-design-microvolt = <3410000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4338000 100>, <4243000 95>,
			<4189000 90>, <4143000 85>, <4102000 80>,
			<4051000 75>, <4002000 70>, <3958000 65>,
			<3901000 60>, <3840000 55>, <3784000 50>,
			<3742000 45>, <3703000 40>, <3673000 35>,
			<3656000 30>, <3622000 25>, <3595000 20>,
			<3558000 15>, <3523000 10>, <3490000 5>,
			<3412000 0>;
	};
};

/* Console + secondary UART. serial1 is the console per /chosen. */
&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

/*
 * microSD. Claim the SD core/IO supplies so the regulator framework keeps
 * them powered without regulator_ignore_unused. Mainline sdhci-sprd sets
 * SDHCI_QUIRK_BROKEN_CARD_DETECTION and ignores the stock syscon card
 * detect; there is no dedicated CD GPIO on this board, so fall back to
 * mmc-core polling via broken-cd. (memory: sdcard-sdio0-bringup)
 */
&sdio0 {
	status = "okay";
	vmmc-supply = <&vddsdcore>;
	vqmmc-supply = <&vddsdio>;
	bus-width = <4>;
	no-sdio;
	no-mmc;
	broken-cd;
	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
	sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
	sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
	sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
};

/* eMMC. vmmc-supply keeps the core rail up without regulator_ignore_unused. */
&sdio3 {
	status = "okay";
	vmmc-supply = <&vddemmccore>;
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	cap-mmc-hw-reset;
};

/* SC2730 fuel gauge — battery voltage / capacity reporting. */
&sc2730_fgu {
	status = "okay";
	monitored-battery = <&bat>;
	sprd,calib-resistance-micro-ohms = <10000>;
};

/*
 * i2c4 SCL/SDA are routed onto the SIMCLK2 / SIMDA2 pads at AF1 with internal
 * pull-ups (source: vendor u-boot ums512_1h10 pinmap). UMS512 has no dedicated
 * SCL4/SDA4 pads and the stock pinmux lived in the neutralized dtbo, so it must
 * be set here or the bus never toggles. NB: sprd DT function naming is
 * 1-indexed vs the AF number (sprd_pmx_set_mux maps "func2" -> AF1), so I2C4 =
 * "func2". (memory: charger-aw32257-i2c4-blocker)
 */
&pinctrl {
	i2c4_pin_func: i2c4-pin-func {
		pins = "UMS512_SIMCLK2", "UMS512_SIMDA2";
		function = "func2";
	};

	i2c4_pin_misc: i2c4-pin-misc {
		pins = "UMS512_SIMCLK2_MISC", "UMS512_SIMDA2_MISC";
		/* 4700 => WPUS|WPU, matching the u-boot pinmap (strong pull for
		 * the open-drain i2c lines). */
		bias-pull-up = <4700>;
	};
};

/*
 * Battery charger. Stock uses an AW32257 (Awinic) at i2c4 0x6a, a register
 * clone of the TI bq24157/bq24158 — drive it with the mainline bq2415x driver.
 * Values from the stock dtbo overlay (charger@6a), converted to bq2415x units.
 */
&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pin_func &i2c4_pin_misc>;
	#address-cells = <1>;
	#size-cells = <0>;

	charger@6a {
		compatible = "ti,bq24158";
		reg = <0x6a>;
		ti,current-limit = <1800>;
		ti,weak-battery-voltage = <3400>;
		ti,battery-regulation-voltage = <4200>;
		ti,charge-current = <2000>;
		ti,termination-current = <200>;
		ti,resistor-sense = <33>;
	};
};

/* Display pipeline. Panel free-runs (see sprd_dpu.c/sprd_dsi.c free-run hack +
 * docs/DISPLAY-BRINGUP.md). (memory: cold-init-prepare-prev-first) */
&iommu_disp {
	status = "okay";
};

&disp {
	status = "okay";
};

&dpu {
	status = "okay";
	memory-region = <&framebuffer_region>;
	reset-syscon = <&ap_ahb_regs 0x04 0x02>;
};

&pwm {
	status = "okay";
};

&dsi {
	status = "okay";
	reset-syscon = <&ap_ahb_regs 0x04 0x01>;

	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		reset-gpios = <&ap_gpio 50 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
		vdd-supply = <&lcd_avdd>;
		iovcc-supply = <&lcd_avee>;

		panel_description =
			"G lanes=2 format=rgb888 size=109,62 flags=3 hs_rate=551488000 lp_rate=20000000 delays=5,50,120,100,50",
			"M clock=38400 horizontal=720,46,2,52 vertical=720,30,2,25 default=1",
