			"I dcs=ff data=52",
			"I dcs=ff data=00",
			"I dcs=36 data=01",
			"I dcs=53 data=2c";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&hsphy {
	status = "okay";
	phy-supply = <&vddusb33>;
};

&usb {
	status = "okay";
	dr_mode = "otg";
};

&gpu {
	mali-supply = <&vddgpu>;
	status = "okay";
};

&dcdc_cpu0 {
	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu0_supply>;
};

&dcdc_cpu1 {
	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu1_supply>;
};

&cpudvfs_dev {
	status = "okay";
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	speaker_amp: audio-codec@58 {
		/* Anbernic reused a previously mainlined awinic 87xxx amp */
		compatible = "anbernic,rgds-amp";
		reg = <0x58>;
		sound-name-prefix = "Speaker Amp";
	};
};

