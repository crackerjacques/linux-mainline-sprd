// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Anbernic RG Rotate (Unisoc UMS512 / T618, sharkl5pro) board DTS.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/clock/sprd,ums512-clk.h>
#include <dt-bindings/mfd/sprd,sc2730-regs.h>
#include <dt-bindings/mfd/sprd,sc2730-mask.h>
#include "ums512.dtsi"
#include "sc2730.dtsi"
#include "sprd-sound-fe-be.dtsi"

/ {
	model = "Anbernic RG Rotate";
	compatible = "sprd,ums512-1h10", "sprd,ums512";
	sprd,sc-id = "ums512 1h10 1000";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0xC0000000>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		stdout-path = "serial1:115200n8";

		framebuffer0: framebuffer@9e000000 {
			compatible = "simple-framebuffer";
			memory-region = <&framebuffer_region>;
			width = <720>;
			height = <720>;
			stride = <(720 * 4)>;
			format = "a8r8g8b8";
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer_region: framebuffer-region@9e000000 {
			compatible = "framebuffer";
			reg = <0 0x9e000000 0 (720 * 720 * 4)>;
			iommu-addresses = <&dpu 0x9e000000 (720 * 720 * 4)>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x0 0x8000000>;
			reusable;
			linux,cma-default;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 2 40000>;
		max-brightness = <4095>;
		default-brightness-level = <2650>;
	};

	lcd_avdd: regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avdd";
		gpio = <&ap_gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	lcd_avee: regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avee";
		gpio = <&ap_gpio 138 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/*
	 * Touch panel power. Stock exposes this as a raw vcc-gpios line on the
	 * goodix node (ap_gpio 16); mainline goodix.c wants a regulator, not a
	 * GPIO toggle, so it's wrapped as a fixed regulator instead.
	 */
	touch_vdd: regulator-touch-vdd {
		compatible = "regulator-fixed";
		regulator-name = "touch-vdd";
		gpio = <&ap_gpio 16 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/*
	 * Gamepad. Stock uses the out-of-tree "singleadc-joypad" driver, which
	 * bundled these GPIO buttons with an ADC stick path (6-way amux +
	 * adc-power-ctl). This SKU is stickless, so the ADC path is inert and
	 * every real input is a discrete &ap_gpio line -> plain gpio-keys.
	 *
	 * D-pad: stock encodes it as shared ABS_HAT0X/Y hats. gpio-keys' EV_ABS
	 * path only fires on press and never recenters on release, so the hats
	 * are remapped to discrete BTN_DPAD_* keys (frontends read these as a
	 * hat). GPIO numbers are the stock overlay_1 hex offsets in decimal;
	 * stock flag 0x01 = GPIO_ACTIVE_LOW.
	 */
	gamepad_keys: gpio-keys-gamepad {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&joypad_pins_func &joypad_pins_misc>;

		/* D-pad */
		btn-dpad-up {
			label = "DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
			gpios = <&ap_gpio 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-dpad-down {
			label = "DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
			gpios = <&ap_gpio 25 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-dpad-left {
			label = "DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
			gpios = <&ap_gpio 97 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-dpad-right {
			label = "DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
			gpios = <&ap_gpio 86 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};

		/* Face buttons */
		btn-a {
			label = "BTN-A";
			linux,code = <BTN_SOUTH>;
			gpios = <&ap_gpio 116 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-b {
			label = "BTN-B";
			linux,code = <BTN_EAST>;
			gpios = <&ap_gpio 112 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-x {
			label = "BTN-X";
			linux,code = <BTN_NORTH>;
			gpios = <&ap_gpio 88 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-y {
			label = "BTN-Y";
			linux,code = <BTN_WEST>;
			gpios = <&ap_gpio 113 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};

		/* Shoulders / triggers */
		btn-tl {
			label = "BTN-TL";
			linux,code = <BTN_TL>;
			gpios = <&ap_gpio 14 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-tr {
			label = "BTN-TR";
			linux,code = <BTN_TR>;
			gpios = <&ap_gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-tl2 {
			label = "BTN-TL2";
			linux,code = <BTN_TL2>;
			gpios = <&ap_gpio 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-tr2 {
			label = "BTN-TR2";
			linux,code = <BTN_TR2>;
			gpios = <&ap_gpio 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};

		/*
		 * No thumb-stick clicks: this SKU has no sticks, so the stock
		 * BTN_THUMBL/THUMBR on ap_gpio 20/23 (RFCTL1/RFCTL4) are absent
		 * physical buttons — omitted, and their pads left un-muxed.
		 */

		/* Start / Select / hotkeys */
		btn-select {
			label = "BTN-SELECT";
			linux,code = <BTN_SELECT>;
			gpios = <&ap_gpio 55 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		btn-start {
			label = "BTN-START";
			linux,code = <BTN_START>;
			gpios = <&ap_gpio 87 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		key-back {
			label = "BACK";
			linux,code = <KEY_BACK>;
			gpios = <&ap_gpio 124 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		key-f9 {
			label = "F9";
			linux,code = <KEY_F9>;
			gpios = <&ap_gpio 125 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
		key-f10 {
			label = "F10";
			linux,code = <KEY_F10>;
			gpios = <&ap_gpio 126 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
		};
	};

	/*
	 * Volume keys — separate node so autorepeat (hold-to-repeat) applies
	 * here but NOT to power/hall below. Vol-down is active-HIGH and on the
	 * PMIC EIC; vol-up is active-low on ap_gpio (stock overlay_1 wiring).
	 */
	volume_keys: gpio-keys-volume {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&volup_pin_func &volup_pin_misc>;

		key-volumedown {
			label = "Volume Down Key";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pmic_eic 4 GPIO_ACTIVE_HIGH>;
			debounce-interval = <2>;
			wakeup-source;
		};
		key-volumeup {
			label = "Volume Up Key";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&ap_gpio 30 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
			wakeup-source;
		};
	};

	/* Power button (PMIC EIC). No autorepeat. */
	sys_keys: gpio-keys-system {
		compatible = "gpio-keys";

		key-power {
			label = "Power Key";
			linux,code = <KEY_POWER>;
			gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <2>;
			wakeup-source;
		};
	};

	/*
	 * Hall swivel sensor on ap_gpio 54 (= SPI2_DI, an alternate-func pad that
	 * needs func4 like the buttons — see hall_pin_func/misc). Per the actual
	 * firmware dtbo; the eic_debounce line 15 in an older decompiled overlay
	 * was a mismatched variant. Modelled as EV_SW, not a key: the screen
	 * rotates, so userspace wants a persistent orientation state, not a
	 * keypress. gpio-keys reports the level on every edge (and the initial
	 * state at probe), so SW_TABLET_MODE holds a constant bool.
	 */
	hall_switch: gpio-keys-hall {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pin_func &hall_pin_misc>;

		hall {
			label = "Hall Swivel";
			linux,input-type = <EV_SW>;
			linux,code = <SW_TABLET_MODE>;
			gpios = <&ap_gpio 54 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};
	};

	bat: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <1900000>;
		charge-term-current-microamp = <120000>;
		constant-charge-voltage-max-microvolt = <4340000>;
		factory-internal-resistance-micro-ohms = <230000>;
		voltage-min-design-microvolt = <3410000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4338000 100>, <4243000 95>,
			<4189000 90>, <4143000 85>, <4102000 80>,
			<4051000 75>, <4002000 70>, <3958000 65>,
			<3901000 60>, <3840000 55>, <3784000 50>,
			<3742000 45>, <3703000 40>, <3673000 35>,
			<3656000 30>, <3622000 25>, <3595000 20>,
			<3558000 15>, <3523000 10>, <3490000 5>,
			<3412000 0>;
	};

	dvfs_dcdc_cpu0_supply: dvfs-dcdc-cpu0-supply {
		pmic-type-num = <0>;
		slew-rate = <9375>; /* 9375uV/us */
		top-dvfs-adi-state = <0x70 0 0xf>;
		voltage-grade-num = <7>;
		voltage-grade = <0 0xf0 0xf4 0 0x1ff>,
			<1 0xf0 0xf4 9 0x1ff>,
			<2 0x100 0xf4 18 0x1ff>,
			<3 0x110 0xf8 0 0x1ff>,
			<4 0x120 0xf8 9 0x1ff>,
			<5 0x130 0xf8 18 0x1ff>,
			<6 0x140 0xfc 0 0x1ff>;
		voltage-up-delay = <50 0x58 0 0xffff 0x600>,
			<100 0x58 16 0xffff 0xa00>,
			<150 0x54 0 0xffff 0xf00>,
			<200 0x54 16 0xffff 0x1400>,
			<250 0x50 0 0xffff 0x1900>,
			<300 0x50 16 0xffff 0x1e00>,
			<350 0x110 0 0xffff 0x2300>;
		voltage-down-delay = <50 0x64 0 0xffff 0x600>,
			<100 0x64 16 0xffff 0xa00>,
			<150 0x60 0 0xffff 0xf00>,
			<200 0x60 16 0xffff 0x1400>,
			<250 0x5c 0 0xffff 0x1900>,
			<300 0x5c 16 0xffff 0x1e00>,
			<350 0x114 0 0xffff 0x2300>;
		tuning-latency-us = <0>;
		chnl-in-i2c = <0>;
	};

	dvfs_dcdc_cpu1_supply: dvfs-dcdc-cpu1-supply {
		chnl-i2c-used;
		third-pmic-used;
		pmic-type-num = <2>;
		slew-rate = <4000>; /* 4000uV/us */
		supply-type-sel = <0x120 0 1>;
		top-dvfs-i2c-state = <0x9c 4 0xf>;
		voltage-grade-num = <6>;
		voltage-grade = <0 0x0f 0x12c 0 0x7f>,
			<1 0x14 0x12c 7 0x7f>,
			<2 0x19 0x12c 14 0x7f>,
			<3 0x1e 0x12c 21 0x7f>,
			<4 0x23 0x130 0 0x7f>,
			<5 0x28 0x130 7 0x7f>;
		voltage-up-delay = <50 0x84 0 0xffff 0x1600>,
			<100 0x84 16 0xffff 0x1a00>,
			<150 0x80 0 0xffff 0x1f00>,
			<200 0x80 16 0xffff 0x2400>,
			<250 0x7c 0 0xffff 0x2900>,
			<300 0x7c 16 0xffff 0x2e00>,
			<350 0x118 0 0xffff 0x3300>;
		voltage-down-delay = <50 0x90 0 0xffff 0x600>,
			<100 0x90 16 0xffff 0xa00>,
			<150 0x8c 0 0xffff 0xf00>,
			<200 0x8c 16 0xffff 0x1400>,
			<250 0x88 0 0xffff 0x1900>,
			<300 0x88 16 0xffff 0x1e00>,
			<350 0x11c 0 0xffff 0x2300>;
		tuning-latency-us = <0>;
		chnl-in-i2c = <1>;
	};
};

&led1 {
	linux,default-trigger = "default-on";
};

&led2 {
	label = "yellow";
};

/* SC2730 fuel gauge — battery voltage / capacity reporting. */
&sc2730_fgu {
	status = "okay";
	monitored-battery = <&bat>;
	sprd,calib-resistance-micro-ohms = <10000>;
};

&sc2730_codec {
	status = "okay";
	sprd,syscon-pmu-apb = <&pmu_apb_regs>;
	hp-use-inter-pa = <1>;
	fixed-sample-rate = <48000 48000 48000>;
	digital-codec = <&sprd_audio_codec_dig>;
};

&sound_vbc_v4_sprd_codec {
	status = "okay";
	/*
	 * Stock Android drives speaker playback through the codec HP path, not
	 * the SC2730 class-D SPK pin, so route Ext Spk/Ext Spk1 to HP Pin only.
	 */
	sprd-audio-card,routing =
		"Ext Spk", "HP Pin",
		"Ext Spk1", "HP Pin";
	sprd,spk-ext-pa-info = <0 0 4 0>;
	sprd,spk-ext-pa-gpio = <&ap_gpio 9 1>;
};

&pinctrl {
	i2c4_pin_func: i2c4-pin-func {
		pins = "UMS512_SIMCLK2", "UMS512_SIMDA2";
		function = "func2";
	};

	i2c4_pin_misc: i2c4-pin-misc {
		pins = "UMS512_SIMCLK2_MISC", "UMS512_SIMDA2_MISC";
		/* 4700 => WPUS|WPU, matching the u-boot pinmap (strong pull for
		 * the open-drain i2c lines). */
		bias-pull-up = <4700>;
	};

    sd0_cd: sd0-cd {
        pins = "UMS512_RFFE1_SDA";
        function = "func4";
    };

	/*
	 * Gamepad buttons whose pads default to a non-GPIO function. The 8
	 * buttons on dedicated GPIOnnn pads work without muxing; these 11 sit on
	 * RF/IIS3/KEYIN pads that need func4 (= GPIO, the u-boot pinmap's 0x30)
	 * plus input-enable and a pull-up (active-low buttons). Mirrors what
	 * gpio_pin_set() does in board/spreadtrum/ums512_1h10/gpio_pin.c.
	 * Referenced from the gamepad_keys node.
	 */
	joypad_pins_func: joypad-pins-func {
		pins = "UMS512_RFSDA0", "UMS512_RFSCK0", "UMS512_RFSEN0",
		       "UMS512_RFSEN1", "UMS512_RFCTL6", "UMS512_RFCTL7",
		       "UMS512_IIS3DO", "UMS512_KEYIN1", "UMS512_KEYIN2";
		function = "func4";
	};

	joypad_pins_misc: joypad-pins-misc {
		pins = "UMS512_RFSDA0_MISC", "UMS512_RFSCK0_MISC",
		       "UMS512_RFSEN0_MISC", "UMS512_RFSEN1_MISC",
		       "UMS512_RFCTL6_MISC", "UMS512_RFCTL7_MISC",
		       "UMS512_IIS3DO_MISC", "UMS512_KEYIN1_MISC",
		       "UMS512_KEYIN2_MISC";
		input-enable;
		bias-pull-up = <20000>;
	};

	/* Vol-up sits on ap_gpio 30 = RFCTL11, another alternate-func pad. */
	volup_pin_func: volup-pin-func {
		pins = "UMS512_RFCTL11";
		function = "func4";
	};

	volup_pin_misc: volup-pin-misc {
		pins = "UMS512_RFCTL11_MISC";
		input-enable;
		bias-pull-up = <20000>;
	};

	/* Hall sensor sits on ap_gpio 54 = SPI2_DI, another alternate-func pad. */
	hall_pin_func: hall-pin-func {
		pins = "UMS512_SPI2_DI";
		function = "func4";
	};

	hall_pin_misc: hall-pin-misc {
		pins = "UMS512_SPI2_DI_MISC";
		input-enable;
		bias-pull-up = <20000>;
	};
};

&iommu_disp {
	status = "okay";
};

&disp {
	status = "okay";
};

&dpu {
	status = "okay";
	memory-region = <&framebuffer_region>;
	reset-syscon = <&ap_ahb_regs 0x04 0x02>;
};

&pwm {
	status = "okay";
};

&dsi {
	status = "okay";
	reset-syscon = <&ap_ahb_regs 0x04 0x01>;

	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		reset-gpios = <&ap_gpio 50 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
		vdd-supply = <&lcd_avdd>;
		iovcc-supply = <&lcd_avee>;

		panel_description =
			"G lanes=2 format=rgb888 size=109,62 flags=3 hs_rate=551488000 lp_rate=20000000 delays=5,50,120,100,50",
			"M clock=38400 horizontal=720,46,2,52 vertical=720,30,2,25 default=1",
			"I dcs=ff data=30",
			"I dcs=ff data=52",
			"I dcs=ff data=01",
			"I dcs=e3 data=00",
			"I dcs=25 data=0a",
			"I dcs=28 data=5f",
			"I dcs=29 data=c2",
			"I dcs=2a data=cf",
			"I dcs=30 data=58",
			"I dcs=37 data=9c",
			"I dcs=38 data=a7",
			"I dcs=39 data=1f",
			"I dcs=44 data=00",
			"I dcs=49 data=3c",
			"I dcs=59 data=fe",
			"I dcs=5c data=00",
			"I dcs=80 data=20",
			"I dcs=91 data=77",
			"I dcs=92 data=77",
			"I dcs=a0 data=55",
			"I dcs=a1 data=50",
			"I dcs=a3 data=58",
			"I dcs=a4 data=9c",
			"I dcs=a7 data=02",
			"I dcs=a8 data=01",
			"I dcs=a9 data=01",
			"I dcs=aa data=fc",
			"I dcs=ab data=28",
			"I dcs=ac data=06",
			"I dcs=ad data=06",
			"I dcs=ae data=06",
			"I dcs=af data=03",
			"I dcs=b0 data=08",
			"I dcs=b1 data=26",
			"I dcs=b2 data=28",
			"I dcs=b3 data=28",
			"I dcs=b4 data=03",
			"I dcs=b5 data=08",
			"I dcs=b6 data=26",
			"I dcs=b7 data=08",
			"I dcs=b8 data=26",
			"I dcs=c0 data=00",
			"I dcs=c1 data=00",
			"I dcs=c2 data=00",
			"I dcs=c3 data=0f",
			"I dcs=ff data=30",
			"I dcs=ff data=52",
			"I dcs=ff data=02",
			"I dcs=b0 data=00",
			"I dcs=b1 data=0f",
			"I dcs=b2 data=12",
			"I dcs=b3 data=32",
			"I dcs=b4 data=24",
			"I dcs=b5 data=3f",
			"I dcs=b6 data=25",
			"I dcs=b7 data=3f",
			"I dcs=b8 data=0e",
			"I dcs=b9 data=06",
			"I dcs=ba data=11",
			"I dcs=bb data=10",
			"I dcs=bc data=10",
			"I dcs=bd data=13",
			"I dcs=be data=1b",
			"I dcs=bf data=10",
			"I dcs=c0 data=17",
			"I dcs=c1 data=08",
			"I dcs=d0 data=00",
			"I dcs=d1 data=0d",
			"I dcs=d2 data=12",
			"I dcs=d3 data=2a",
			"I dcs=d4 data=2e",
			"I dcs=d5 data=3f",
			"I dcs=d6 data=29",
			"I dcs=d7 data=43",
			"I dcs=d8 data=10",
			"I dcs=d9 data=08",
			"I dcs=da data=13",
			"I dcs=db data=10",
			"I dcs=dc data=12",
			"I dcs=dd data=13",
			"I dcs=de data=1f",
			"I dcs=df data=1a",
			"I dcs=e0 data=1f",
			"I dcs=e1 data=0a",
			"I dcs=ff data=30",
			"I dcs=ff data=52",
			"I dcs=ff data=03",
			"I dcs=04 data=51",
			"I dcs=05 data=c0",
			"I dcs=06 data=c0",
			"I dcs=08 data=86",
			"I dcs=09 data=87",
			"I dcs=0a data=84",
			"I dcs=0b data=85",
			"I dcs=28 data=33",
			"I dcs=29 data=33",
			"I dcs=2a data=eb",
			"I dcs=2b data=ea",
			"I dcs=2c data=ed",
			"I dcs=2d data=ec",
			"I dcs=34 data=81",
			"I dcs=35 data=53",
			"I dcs=37 data=23",
			"I dcs=40 data=84",
			"I dcs=41 data=85",
			"I dcs=42 data=82",
			"I dcs=43 data=83",
			"I dcs=44 data=33",
			"I dcs=45 data=ea",
			"I dcs=46 data=e9",
			"I dcs=47 data=33",
			"I dcs=48 data=ec",
			"I dcs=49 data=eb",
			"I dcs=50 data=80",
			"I dcs=51 data=81",
			"I dcs=52 data=02",
			"I dcs=53 data=01",
			"I dcs=54 data=33",
			"I dcs=55 data=ee",
			"I dcs=56 data=ed",
			"I dcs=57 data=33",
			"I dcs=58 data=f0",
			"I dcs=59 data=ef",
			"I dcs=80 data=00",
			"I dcs=81 data=01",
			"I dcs=82 data=06",
			"I dcs=83 data=07",
			"I dcs=84 data=04",
			"I dcs=85 data=05",
			"I dcs=92 data=03",
			"I dcs=93 data=02",
			"I dcs=96 data=00",
			"I dcs=97 data=01",
			"I dcs=98 data=06",
			"I dcs=99 data=07",
			"I dcs=9a data=04",
			"I dcs=9b data=05",
			"I dcs=a8 data=03",
			"I dcs=a9 data=02",
			"I dcs=ff data=30",
			"I dcs=ff data=52",
			"I dcs=ff data=00",
			"I dcs=36 data=01",
			"I dcs=53 data=2c";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&hsphy {
	status = "okay";
	phy-supply = <&vddusb33>;
};

&usb {
	status = "okay";
	dr_mode = "otg";
};

&gpu {
	mali-supply = <&vddgpu>;
	status = "okay";
};

&dcdc_cpu0 {
	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu0_supply>;
};

&dcdc_cpu1 {
	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu1_supply>;
};

&cpudvfs_dev {
	status = "okay";
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	speaker_amp: audio-codec@58 {
		/* Anbernic reused a previously mainlined awinic 87xxx amp */
		compatible = "anbernic,rgds-amp";
		reg = <0x58>;
		sound-name-prefix = "Speaker Amp";
	};
};

/*
 * Touchscreen. Stock uses a Goodix GT911 (paired with the lcd_gt911_mipi_ab021
 * panel; 186-byte cfg-group0 matches the smaller GT911-class config) behind
 * the generic "goodix,gt9xx" downstream driver on i2c3. Config is read back
 * from the chip over i2c by the mainline driver, so the vendor cfg-group0
 * blob and all goodix,* tuning props are dropped; only irq/reset gpios and a
 * supply are needed.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		AVDD28-supply = <&touch_vdd>;
		VDDIO-supply = <&touch_vdd>;
		irq-gpios = <&ap_gpio 144 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&ap_gpio 145 GPIO_ACTIVE_HIGH>;
		touchscreen-size-x = <720>;
		touchscreen-size-y = <720>;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
	};
};

/*
 * Battery charger. Stock uses an AW32257 (Awinic) at i2c4 0x6a, a register
 * clone of the TI bq24157/bq24158. Values have been translated from the
 * stock dtbo overlay (charger@6a) to bq2415x units.
 */
&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pin_func &i2c4_pin_misc>;
	#address-cells = <1>;
	#size-cells = <0>;

	sc2730_charger: charger@6a {
		compatible = "ti,bq24158";
		reg = <0x6a>;
		ti,current-limit = <1800>;
		ti,weak-battery-voltage = <3400>;
		ti,battery-regulation-voltage = <4200>;
		ti,charge-current = <2000>;
		ti,termination-current = <200>;
		ti,resistor-sense = <33>;
	};
};

&sdio0 {
	status = "okay";
	vmmc-supply = <&vddsdcore>;
	vqmmc-supply = <&vddsdio>;
	cd-gpios = <&eic_sync 19 GPIO_ACTIVE_LOW>;
	bus-width = <4>;
	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
	sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
	sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
	sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	no-sdio;
	no-mmc;
};

&sdio3 {
	status = "disabled";
	vmmc-supply = <&vddemmccore>;
	bus-width = <8>;
	voltage-ranges = <3000 3000>;
	non-removable;
	cap-mmc-hw-reset;
	sprd,phy-delay-mmc-hs400es = <0x40 0x7f 0x2d 0x2d>;
	sprd,phy-delay-mmc-hs400 = <0x3f 0xdf 0x2f 0x2f>;
	sprd,phy-delay-mmc-hs200 = <0x7f 0xde 0xd4 0xd4>;
	sprd,phy-delay-mmc-ddr52 = <0x3e 0x37 0x24 0x24>;
	sprd,phy-delay-mmc-highspeed = <0x60 0xb7 0x34 0x34>;
	mmc-hs400-enhanced-strobe;
	mmc-hs400-1_8v;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;
	no-sdio;
	no-sd;
};

/*
 * Wi-Fi/BT/FM/GNSS: external Unisoc Marlin3-Lite (SC2355) WCN combo on the
 * SDIO1 controller (0x71200000). The marlin core powers the chip (enable/reset
 * GPIOs + regulators), downloads firmware over SDIO, then triggers a card
 * rescan on sdio1 via the extcon link so the SDIO function enumerates.
 */
&sdio1 {
	status = "okay";
	bus-width = <4>;
	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x76 0x69 0x69>;
	sprd,phy-delay-sd-uhs-sdr50 = <0x7f 0xf7 0xf5 0xf5>;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	no-sd;
	no-mmc;
};

/ {
	sprd_marlin3: sprd-marlin3 {
		compatible = "unisoc,marlin3lite_sdio";

		/*
		 * &ap_gpio pins from the stock RG Rotate dtbo (overlay_1, the
		 * joypad variant): enable 143, reset 95, m2-wakeup-ap 33,
		 * m2-to-ap-irq 94. m2-wakeup-ap is the SDIO RX data-ready line
		 * sdiohal takes its interrupt from, so it MUST be correct or no
		 * received packet is ever delivered. (The camera variant
		 * overlay_0 uses 97/32/96 - do not use those here.)
		 */
		enable-gpios = <&ap_gpio 143 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ap_gpio 95 GPIO_ACTIVE_LOW>;
		m2-wakeup-ap-gpios = <&ap_gpio 33 GPIO_ACTIVE_LOW>;
		m2-to-ap-irq-gpios = <&ap_gpio 94 GPIO_ACTIVE_LOW>;
		adma-tx;
		adma-rx;

		clock-names = "clk_32k", "source", "enable";
		clocks = <&aon_clk CLK_AUX0>, <&ext_32k>,
			 <&aonapb_gate CLK_AUX0_EB>;

		extcon = <&sdio1>;
		sdhci-name = <&sdio1>;

		/*
		 * Primary firmware path is request_firmware("wcnmodem.bin") from
		 * /lib/firmware. These file-name properties are the partition/direct
		 * fallback if request_firmware fails.
		 */
		sprd,btwf-file-name = "/lib/firmware/wcnmodem.bin";
		sprd,gnss-file-name = "/lib/firmware/gnssmodem.bin";

		avdd12-supply = <&vddwcn>;
		avdd33-supply = <&vddwifipa>;
		dcxo18-supply = <&vddsim2>;

		avdd12-parent-bound-chip = <REG_ANA_SLP_DCDC_PD_CTRL MASK_ANA_SLP_DCDCGEN1_PD_EN 0x0 MASK_ANA_SLP_DCDCGEN1_PD_EN>;
		avdd12-bound-wbreq = <REG_ANA_LDO_XTL_EN10 MASK_ANA_LDO_VDDWCN_EXT_XTL3_EN 0x0 MASK_ANA_LDO_VDDWCN_EXT_XTL3_EN>;
		avdd33-bound-wbreq = <REG_ANA_LDO_XTL_EN11 MASK_ANA_LDO_VDDWIFIPA_EXT_XTL3_EN 0x0 MASK_ANA_LDO_VDDWIFIPA_EXT_XTL3_EN>;

		wlan {
			compatible = "sprd,sc2355-sdio-wifi";
		};

		gnss {
			compatible = "sprd,gnss";
		};

		sprd-mtty {
			compatible = "sprd,mtty";
			/*
			 * btsprdsdio derives a stable, per-unit locally-
			 * administered BD address from the SoC's 64-bit die UID
			 * (efuse@800 uid-start/uid-end) and sets it via
			 * set_bdaddr() during setup. This also marks the
			 * controller configured; without a valid address hci0
			 * comes up HCI_UNCONFIGURED and "hciconfig hci0 up"
			 * returns EOPNOTSUPP. An optional "local-bd-address"
			 * property here still overrides the derived address.
			 */
			nvmem-cells = <&uid_start>, <&uid_end>;
			nvmem-cell-names = "uid-start", "uid-end";
		};
	};
};
