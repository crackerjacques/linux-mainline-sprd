		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&hsphy {
	status = "okay";
	phy-supply = <&vddusb33>;
};

/*
 * USB. dr_mode MUST stay "otg": the sprd musb glue only registers the
 * usb_role_switch (/sys/class/usb_role/*) in OTG mode, and this board has no
 * extcon/VBUS session edge -- the PHY force-asserts VBUS. The gadget session +
 * D+ pullup are asserted via sprd_otg_switch_set(DEVICE) (drivers/usb/musb/
 * sprd.c board hack), which the initramfs init triggers by writing "device" to
 * the role sysfs. dr_mode="peripheral" drops the role switch -> the init dance
 * no-ops and the gadget never enumerates (host sees -71).
 * (memory: usb-gadget-otg-and-cleanup)
 */
&usb {
	status = "okay";
	dr_mode = "otg";
};

/*
 * ===========================================================================
 * STAGED — blocked on SoC nodes not yet present in upstream 7.1 ums512.dtsi.
 * Port each SoC node into the 7.1 dtsi, then un-stage the matching board
 * block here. Order mirrors docs/REBASE-7.1-SURVEY.md (lowest risk first).
 * ===========================================================================
 *
 * [x] ap_gpio + pinctrl  — DONE. Ported ap_gpio@70000 + pinctrl@450000 SoC
 *       nodes into ums512.dtsi (offset-addr under aon bus@32000000) and the
 *       pinctrl-sprd-ums512.c driver (drops in clean; framework identical to
 *       6.16). Configs: PINCTRL_SPRD_UMS512, GPIO_SPRD, GPIO_EIC_SPRD.
 *       (ums9230 pinctrl data does NOT cover ums512 pins — own driver kept.)
 *
 * [x] i2c + charger  — DONE. Ported i2c0..i2c4 controllers into ums512.dtsi
 *       apb@70000000 (offset addrs; upstream's apb bus ALREADY uses the
 *       offset-range scheme our 6.16 fix had to add, so i2c4 lands at
 *       0x00700000 for free). i2c4 pinmux + charger@6a un-staged above.
 *       (memory: charger-aw32257-i2c4-blocker)
 *
 * [x] USB  — DONE. Ported hsphy (anlg_phy_g2) + usb@5fff0000 (under soc) SoC
 *       nodes into ums512.dtsi, and re-applied the board musb DEVICE-case hack
 *       in drivers/usb/musb/sprd.c (upstream only added OTG_STATE_B_IDLE; it
 *       still does not assert a gadget session on this VBUS-edge-less board).
 *       Board &hsphy/&usb un-staged above. (memory: usb-gadget-otg-and-cleanup)
 *
 * [x] Display  — DONE (on-device validation pending). DT: dpu/iommu_disp/dsi
 *       (mm bus), disp, pwm, dphy clocks + board framebuffer/backlight/lcd-regs/
 *       panel. Drivers: the proven 6.16 sprd_dpu/dsi/megacores_pll carried
 *       wholesale (compile clean against 7.1 DRM) — free-run, cold-init reset +
 *       clock prep, prepare_prev_first. (memory: cold-init-prepare-prev-first;
 *       docs/DISPLAY-BRINGUP, DISPLAY-KNOWN-GOOD-DSI-STATE)
 *
 * [ ] GPU panfrost  (memory: gpu-panfrost-bringup)
 *       upstream dtsi has only gpu_clk syscon, no mali device node — port it.
 *       Re-verify sprd_reset_deassert PC=0x0 fix vs reorganized clk/reset.c.
 *
 * [ ] cpufreq DVFS  (memory: thermal-cpufreq-bringup)
 *       prefer upstream sprd-cpufreq-v2; board: dvfs_dcdc_cpu0/1 supply cfg +
 *       &dcdc_cpu0/1 dcdc-supply-mode-cfg + &cpudvfs_dev. Re-verify
 *       topology_cluster_id result holds on v2.
 *
 * [ ] Audio  (memory: audio-bringup; docs/AUDIO-THEORY)
 *       needs codec/VBC/pcm SoC graph. board: i2c2 speaker_amp aw87391@58
 *       (en-gpio 9), &sc2730_codec okay, sound card "sprd,ums512-audio-card"
 *       (IIS0 link, dig_codec+sc2730_codec). Do NOT re-add AUDIF soft-reset.
 */
