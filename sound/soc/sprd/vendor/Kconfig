config SND_SOC_UNISOC_VBC_V4_SC2730
	bool "Vendor-ported UMS512 audio stack (VBC v4 + SC2730 codec)"
	depends on ARCH_SPRD || COMPILE_TEST
	depends on MAILBOX && MFD_SC27XX_PMIC
	select REGMAP_MMIO
	help
	  Faithful port of the Unisoc 5.4 BSP audio stack for the
	  sharkl5pro/UMS512: audio SIPC over the AGDSP mailbox, audio
	  shared-memory manager, AGDSP access control, AGCP dmaengine PCM
	  platform, PCM routing, FE DAIs, VBC v4 DAI, SC2730 analog codec,
	  audio power regulators and the vbc-v4-codec-sc2730 machine card.
	  Needed for the NORMAL_AP01 playback path on the RG Rotate.
